{
  "Urls": "http://0.0.0.0:5000",
  "Cors": {
    "Origins": [
      "http://localhost:4200"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-0": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "identity-1": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "identity-2": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/roles/{**catch-all}"
        }
      },
      "identity-3": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/permissions/{**catch-all}"
        }
      },
      "identity-4": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/tenants/{**catch-all}"
        }
      },
      "inventory-0": {
        "ClusterId": "inventory",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "inventory-1": {
        "ClusterId": "inventory",
        "Match": {
          "Path": "/api/warehouses/{**catch-all}"
        }
      },
      "inventory-2": {
        "ClusterId": "inventory",
        "Match": {
          "Path": "/api/stock/{**catch-all}"
        }
      },
      "inventory-3": {
        "ClusterId": "inventory",
        "Match": {
          "Path": "/api/shipments/{**catch-all}"
        }
      },
      "inventory-4": {
        "ClusterId": "inventory",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        }
      },
      "procurement-0": {
        "ClusterId": "procurement",
        "Match": {
          "Path": "/api/suppliers/{**catch-all}"
        }
      },
      "procurement-1": {
        "ClusterId": "procurement",
        "Match": {
          "Path": "/api/purchase-orders/{**catch-all}"
        }
      },
      "localization-0": {
        "ClusterId": "localization",
        "Match": {
          "Path": "/api/currencies/{**catch-all}"
        }
      },
      "localization-1": {
        "ClusterId": "localization",
        "Match": {
          "Path": "/api/exchange-rates/{**catch-all}"
        }
      },
      "localization-2": {
        "ClusterId": "localization",
        "Match": {
          "Path": "/api/tax/{**catch-all}"
        }
      },
      "localization-3": {
        "ClusterId": "localization",
        "Match": {
          "Path": "/api/translations/{**catch-all}"
        }
      },
      "workflow-0": {
        "ClusterId": "workflow",
        "Match": {
          "Path": "/api/workflows/{**catch-all}"
        }
      },
      "audit-0": {
        "ClusterId": "audit",
        "Match": {
          "Path": "/api/audit/{**catch-all}"
        }
      },
      "analytics-0": {
        "ClusterId": "analytics",
        "Match": {
          "Path": "/api/analytics/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "inventory": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "procurement": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "localization": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5004"
          }
        }
      },
      "workflow": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5005"
          }
        }
      },
      "audit": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5006"
          }
        }
      },
      "analytics": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5007"
          }
        }
      }
    }
  }
}